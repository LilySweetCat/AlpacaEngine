<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ApplicationIcon>assets/icons/alpaca.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
      <PackageReference Include="JoltPhysicsSharp" Version="2.22.0" />
      <PackageReference Include="Raylib-cs" Version="8.1.0" />
      <PackageReference Include="rlImgui-cs" Version="3.2.0" />
    </ItemGroup>

    <ItemGroup>
      <None Update="imgui.ini">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="assets/icons/*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- Lets the nested test project call internal editor types directly instead of using reflection. -->
    <ItemGroup>
      <InternalsVisibleTo Include="AlpacaEngine.Tests" />
    </ItemGroup>

    <!-- The test project is nested in this folder; keep it out of this project's default item globs. -->
    <ItemGroup>
      <Compile Remove="AlpacaEngine.Tests/**" />
      <None Remove="AlpacaEngine.Tests/**" />
      <EmbeddedResource Remove="AlpacaEngine.Tests/**" />
    </ItemGroup>

</Project>
